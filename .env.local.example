# ============================================
# Shortify AI - Environment Variables
# ============================================

# Database
DATABASE_URL=postgresql://storycraft:YOUR_DB_PASSWORD@localhost:5432/shortify_ai

# Auth
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:8000

# Upload
UPLOAD_DIR=./uploads

# 智谱 GLM API
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 图像生成模型 (cogview-3-plus / glm-image)
IMAGE_MODEL=cogview-3-plus

# 视频生成模型 (cogvideox-3 / viduq1-text)
VIDEO_MODEL=cogvideox-3

# 视频生成参数
VIDEO_QUALITY=quality          # quality | speed
VIDEO_SIZE=1920x1080           # 1280x720 | 1920x1080 | 3840x2160
VIDEO_FPS=30                   # 30 | 60
VIDEO_DURATION=5               # 5 | 10

# 腾讯云 COS
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-bucket-name
COS_REGION=ap-shanghai

# 讯飞 TTS (可选，Edge-TTS 作为降级方案)
XUNFEI_APPID=your-xunfei-appid
XUNFEI_API_KEY=your-xunfei-api-key
XUNFEI_API_SECRET=your-xunfei-api-secret

# AI BGM (Phase 4 - 可选)
# SUNO_API_KEY=your-suno-api-key

# 可灵 AI (Kling) - 角色一致性图像 + 视频生成
# 有角色参考图时自动启用 Kling；设置 IMAGE_PROVIDER=kling 强制所有图片走 Kling
# KLING_ACCESS_KEY=your-kling-access-key
# KLING_SECRET_KEY=your-kling-secret-key
# KLING_MODEL=kling-v1.6

# 可灵视频生成（可选，有角色参考图时自动启用）
# KLING_VIDEO_MODEL=kling-v1.6
# KLING_VIDEO_SIZE=1280x720
# KLING_VIDEO_DURATION=5
