# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shortify_ai

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
GOOGLE_CLIENT_ID=
