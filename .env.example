# ============================================
# Shortify AI - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ---- Required (必填) ----

# Database (PostgreSQL)
DATABASE_URL=postgresql://shortify:shortify123@localhost:5432/shortify_ai

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# GLM API (智谱) - Required for AI script/storyboard/video generation
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Upload storage
UPLOAD_DIR=./uploads

# ---- AI Models (可选 - 有默认值) ----

# Image generation model
IMAGE_MODEL=cogview-3-plus

# AI video generation model
VIDEO_MODEL=cogvideox-3

# Video provider: cogvideo | kling | liblib
VIDEO_PROVIDER=cogvideo

# Image provider (when set to "kling", Kling is used for all images)
# IMAGE_PROVIDER=kling

# Video generation parameters
VIDEO_QUALITY=quality               # quality | speed
VIDEO_SIZE=1920x1080                # 1280x720 | 1920x1080 | 3840x2160
VIDEO_FPS=30                        # 30 | 60
VIDEO_DURATION=5                    # 5 | 10

# ---- Alibaba DashScope 阿里百炼 (可选 - Wan 生图/生视频 + CosyVoice 配音) ----
# 配置后自动启用: wan2.7 参考图生图（角色一致性）/ wan i2v / CosyVoice 情感 TTS
# 注意: CosyVoice 仅在百炼华北2（北京）地域可用

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
COSYVOICE_MODEL=cosyvoice-v2
# 启用角色参考图生图需将 IMAGE_MODEL 设为 wan2.7-image-pro（见上方 IMAGE_MODEL）

# ---- Tencent Cloud COS (可选 - 未配置时使用本地存储) ----

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# ---- Xunfei TTS (可选 - 未配置时使用 Edge-TTS 作为降级方案) ----

XUNFEI_APPID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# ---- Kling AI 可灵 (可选 - 角色一致性图像/视频生成) ----
# 有角色参考图时自动启用；设置 IMAGE_PROVIDER=kling 强制所有图片走 Kling

KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api.klingai.com
KLING_MODEL=kling-v1.6
KLING_NEGATIVE_PROMPT=low quality, blurry, distorted, ugly, bad anatomy, watermark, text, logo, signature, monochrome, bad proportions, extra limbs
KLING_POLL_INTERVAL_MS=3000
KLING_MAX_POLL_TIME_MS=120000

# Kling video generation (可选)
KLING_VIDEO_MODEL=kling-v1.6
KLING_VIDEO_SIZE=1280x720
KLING_VIDEO_DURATION=5
KLING_VIDEO_POLL_INTERVAL_MS=5000
KLING_MAX_VIDEO_POLL_TIME_MS=300000

# Kling 对口型 (可选 - 消耗可灵算力，显式开启后才生效)
# 对白镜头 AI 视频生成后，自动用角色配音驱动口型（失败自动退回普通视频）
KLING_LIPSYNC=false
KLING_LIPSYNC_MODEL=v1

# ---- LibLib AI (可选 - 备选视频生成服务) ----

LIBLIB_ACCESS_KEY=
LIBLIB_SECRET_KEY=
LIBLIB_BASE_URL=
LIBLIB_IMAGE_CHECKPOINT=
LIBLIB_VIDEO_MODEL=

# ---- Google OAuth (可选) ----

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- SMTP (可选 - 邮箱验证与密码重置) ----
# QQ邮箱: host=smtp.qq.com, port=465
# 163邮箱: host=smtp.163.com, port=465

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Shortify AI

# ---- WebSocket (可选) ----

WS_PORT=8001

# ---- Public URL (可选) ----

NEXT_PUBLIC_BASE_URL=
