# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shortify_ai

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GLM API (智谱)
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Storage
UPLOAD_DIR=./uploads

# Tencent Cloud COS (optional - falls back to local storage if not set)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=shortify-ai-1234567890
COS_REGION=ap-guangzhou

# Kling AI (可灵) - for character-consistent image AND video generation
# When character reference images are available, Kling is used automatically
# Set IMAGE_PROVIDER=kling to force Kling for all images; unset to use CogView by default
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api.klingai.com
KLING_MODEL=kling-v1.6
KLING_NEGATIVE_PROMPT=low quality, blurry, distorted, ugly, bad anatomy, watermark, text, logo, signature, monochrome, bad proportions, extra limbs
KLING_POLL_INTERVAL_MS=3000
KLING_MAX_POLL_TIME_MS=120000

# Kling video generation (optional - only used for video when character refs available)
KLING_VIDEO_MODEL=kling-v1.6
KLING_VIDEO_SIZE=1280x720
KLING_VIDEO_DURATION=5
KLING_VIDEO_POLL_INTERVAL_MS=5000
KLING_MAX_VIDEO_POLL_TIME_MS=300000
